{
	"name": "honeypot",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test",
		"licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;MIT-0;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;Unlicense\"",
		"cf-typegen": "wrangler types",
		"test:honeypot": "node test_honeypot.js",
		"test:post": "node test_post.js",
		"test:full": "npm run test:honeypot && npm run test:post",
		"test:generators": "node test_new_generators.js",
		"logs": "wrangler tail",
		"logs:pretty": "wrangler tail --format pretty",
		"logs:json": "wrangler tail --format json",
		"webhook": "node webhook-example.js",
		"deploy:staging": "wrangler deploy --env staging",
		"deploy:production": "wrangler deploy --env production"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"eslint": "10.12.0",
		"eslint-plugin-security": "4.2.0",
		"license-checker-rseidelsohn": "5.0.1",
		"typescript": "^5.5.2",
		"typescript-eslint": "8.71.0",
		"vitest": "4.1.11",
		"wrangler": "4.147.0"
	},
	"overrides": {
		"miniflare": {
			"undici": "7.29.1",
			"sharp": "0.35.5"
		}
	}
}
